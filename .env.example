# ===================================================================
# Athenea - Environment Configuration Template
# Copy this file to .env and adjust credentials for your deployment.
# ===================================================================

# -------------------------------------------------------------------
# PostgreSQL Database Settings
# -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=athenea
DB_USER=athenea
DB_PASSWORD=replace_with_secure_password

# -------------------------------------------------------------------
# Storage Paths
# -------------------------------------------------------------------
# Root directory where your book files (.epub, .fb2, .pdf, .mobi) are stored
LIBRARY_ROOT=/data/books

# Directory where database backups will be saved
BACKUP_DIR=/data/backups

# Cache directory for generated WebP cover thumbnails
THUMB_CACHE_DIR=/data/cache/thumbs

# -------------------------------------------------------------------
# Security & Session Settings
# -------------------------------------------------------------------
# Set to 'true' if running behind an HTTPS reverse proxy (Nginx, Caddy, Traefik)
COOKIE_SECURE=false

# Number of failed login attempts before temporary IP rate limit
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=300

# -------------------------------------------------------------------
# User Registration Policy
# -------------------------------------------------------------------
# Allow new visitors to register on /register
ALLOW_REGISTRATION=false

# Require administrator approval before newly registered users can log in
REQUIRE_APPROVAL=true

# -------------------------------------------------------------------
# SMTP Mail Delivery (Optional - for Send-to-Kindle)
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=books@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
